# Copy to .env  (never commit .env or real keys)
DATABASE_URL=postgresql+psycopg2://spend:spend@db:5432/spendwise
REDIS_URL=redis://redis:6379/0
USE_CELERY=true
CONF_THRESHOLD=0.60
RATE_LIMIT_PER_MIN=120

# Copilot (optional). Free keys: Groq console or Google AI Studio (OpenAI-compatible endpoints)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
